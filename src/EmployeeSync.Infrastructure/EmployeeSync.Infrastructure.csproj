<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EmployeeSync.Application\EmployeeSync.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="NATS.Client.Core" Version="3.3.2" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <!-- Pinned: Microsoft.Data.SqlClient pulls a vulnerable 9.0.x transitively (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-SQL scripts deployed by migrations (see Persistence/Migrations). -->
    <EmbeddedResource Include="Persistence\Sql\*.sql" LogicalName="EmployeeSync.Sql.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="EmployeeSync.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
