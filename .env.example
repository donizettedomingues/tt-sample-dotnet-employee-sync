# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# TrackTik mock API: values from oauth-credentials.json in your test package.
# TRACKTIK__TOKENURL is NOT under /v1; TRACKTIK__APIBASEURL includes /v1.
TRACKTIK__TOKENURL=https://<api-host>/oauth/token
TRACKTIK__APIBASEURL=https://<api-host>/v1
TRACKTIK__CLIENTID=<client_id>
TRACKTIK__CLIENTSECRET=<client_secret>

# Local-only SQL Server SA password for docker-compose (needs upper, lower, digit, symbol; 8+ chars).
MSSQL_SA_PASSWORD=<choose-a-local-password>

# Nats (default in compose) or InMemory
EVENTS__PUBLISHER=Nats
